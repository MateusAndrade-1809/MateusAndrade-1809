{
  "name": "devquest-portifolio-rpg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts --host 127.0.0.1 --port 3000",
    "build": "npm run typecheck && npm run build:pages",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/pages-legacy-aliases.mjs",
    "start": "vite preview --config vite.pages.config.ts --host 127.0.0.1 --port 3000",
    "test": "node --experimental-strip-types --test tests/portfolio.test.mjs",
    "test:e2e": "npm run build && node tests/browser-check.mjs",
    "snapshot": "node --experimental-strip-types scripts/refresh-github-snapshot.mjs",
    "typecheck": "tsc --project tsconfig.portfolio.json",
    "lint": "eslint app/portfolio app/DevQuest.tsx github-pages-src/main.tsx"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "lucide-react": "^1.56.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "playwright": "^1.64.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.3.4"
  },
  "type": "module"
}
